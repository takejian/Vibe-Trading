#!/usr/bin/env python3
"""lint-manifest — report dependency drift between pyproject.toml and agent/requirements.txt.

The hash-pinned lock (requirements-lock.txt) is compiled from
agent/requirements.txt, while pip install -e . resolves [project].dependencies
from pyproject.toml. The two human-maintained source manifests must name the
same core dependency set, otherwise Docker/locked installs and editable installs
silently diverge.

Normal mode (default): prints drift, exits 0 — a non-blocking report, suitable
for `make lint` while any historical drift is being cleaned up.
Strict mode (--strict): exits 1 on any drift — for future CI promotion.

Stdlib only: tomllib / sys / re / pathlib.
"""

from __future__ import annotations

import re
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PYPROJECT = ROOT / "pyproject.toml"
REQUIREMENTS = ROOT / "agent" / "requirements.txt"

_SPLIT_RE = re.compile(r"[<>=!~\[; \t]")


def _norm(name: str) -> str:
    # PEP 503 normalization: lowercase, runs of -/_/. collapse to -.
    return re.sub(r"[-_.]+", "-", name.strip().lower())


def _from_requirement_line(line: str) -> str | None:
    line = line.strip()
    if not line or line.startswith(("#", "-")):
        return None
    token = _SPLIT_RE.split(line, maxsplit=1)[0]
    return _norm(token) if token else None


def main(argv: list[str]) -> int:
    strict = "--strict" in argv

    with PYPROJECT.open("rb") as fh:
        data = tomllib.load(fh)
    pyproject_deps = {
        _norm(_SPLIT_RE.split(d.strip(), maxsplit=1)[0])
        for d in data.get("project", {}).get("dependencies", [])
    }
    requirements_deps = {
        name
        for line in REQUIREMENTS.read_text(encoding="utf-8").splitlines()
        if (name := _from_requirement_line(line))
    }

    only_pyproject = sorted(pyproject_deps - requirements_deps)
    only_requirements = sorted(requirements_deps - pyproject_deps)

    print(f"## Dependency manifest drift ({PYPROJECT.name} vs {REQUIREMENTS.relative_to(ROOT)})")
    print(
        f"core deps: pyproject={len(pyproject_deps)} requirements={len(requirements_deps)} "
        f"(normalized per PEP 503)"
    )

    if not only_pyproject and not only_requirements:
        print("manifest drift: none")
        return 0

    if only_pyproject:
        print(f"  in pyproject only ({len(only_pyproject)}): {', '.join(only_pyproject)}")
    if only_requirements:
        print(f"  in requirements only ({len(only_requirements)}): {', '.join(only_requirements)}")
    print(
        "Fix: align the two manifests (add the missing entry or remove the stale one), "
        "then regenerate requirements-lock.txt via the uv compile flow."
    )
    return 1 if strict else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
